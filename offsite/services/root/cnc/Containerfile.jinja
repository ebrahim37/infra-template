FROM docker.io/library/alpine:3.24

RUN apk add --no-cache \
		age \
		bash \
		btop \
		build-base \
		bubblewrap \
		busybox-openrc \
		clang-extra-tools \
		curl \
		eza \
		exfatprogs \
		git \
		less \
		ncdu \
		ncurses-terminfo \
		neovim \
		npm \
		openrc-init \
		openssh \
		openssh-server-pam \
		pam-rundir \
		plocate \
		pnpm \
		podman \
		python3 \
		ripgrep \
		screen \
		sops \
		sudo \
		unzip \
		waypipe \
		vim

RUN croc_version=$(curl -fsSIL -o /dev/null -w '%{url_effective}' https://github.com/schollz/croc/releases/latest | sed 's#.*/v##') \
	&& croc_archive="croc_v${croc_version}_Linux-ARM64.tar.gz" \
	&& croc_url="https://github.com/schollz/croc/releases/download/v${croc_version}" \
	&& curl -fsSL "${croc_url}/${croc_archive}" -o "/tmp/${croc_archive}" \
	&& tar -xzf "/tmp/${croc_archive}" -C /usr/bin croc \
	&& rm "/tmp/${croc_archive}"

RUN addgroup -g 1000 ebrahim \
	&& adduser -D -u 1000 -G ebrahim -s /bin/bash ebrahim \
	&& addgroup ebrahim wheel \
	&& passwd -d ebrahim \
	&& printf '%s\n' \
		'%wheel ALL=(ALL:ALL) NOPASSWD: ALL' \
		> /etc/sudoers.d/10-sudo-nopasswd \
	&& printf '%s\n' 'ebrahim:100000:65536' > /etc/subuid \
	&& printf '%s\n' 'ebrahim:100000:65536' > /etc/subgid

RUN printf '%s\n' \
		'Port 222' \
		'PermitRootLogin no' \
		'PubkeyAuthentication yes' \
		'AuthenticationMethods publickey' \
		'PasswordAuthentication no' \
		'KbdInteractiveAuthentication no' \
		'UsePAM yes' \
		'HostKey /host/etc/ssh/ssh_host_ed25519_key' \
		'HostKey /host/etc/ssh/ssh_host_ecdsa_key' \
		'HostKey /host/etc/ssh/ssh_host_rsa_key' \
		'# needed for waypipe' \
		'AllowTcpForwarding yes' \
		> /etc/ssh/sshd_config.d/10-cnc.conf \
	&& printf '%s\n' 'SSHD_BINARY=/usr/sbin/sshd.pam' > /etc/conf.d/sshd \
	&& rc-update add syslog boot \
	&& rc-update add cgroups \
	&& rc-update add sshd default \
	&& rm -f /etc/motd

COPY shared/vimrc /etc/vim/vimrc
COPY --chown=ebrahim:ebrahim shared/ssh_config /home/ebrahim/.ssh/config
COPY --chown=ebrahim:ebrahim shared/home/ /home/ebrahim/
COPY --chown=ebrahim:ebrahim shared/scripts/common/ /home/ebrahim/scripts/
COPY --chown=ebrahim:ebrahim shared/scripts/cnc/ /home/ebrahim/scripts/
COPY --chown=ebrahim:ebrahim home/ /home/ebrahim/
RUN printf '%s\n' '{{ shared.ssh_authorized_key }}' > /home/ebrahim/.ssh/authorized_keys \
	&& chown ebrahim:ebrahim /home/ebrahim/.ssh/authorized_keys \
	&& install -d -m 0700 -o ebrahim -g ebrahim /home/ebrahim/.config/sops/age \
	&& ln -s /host/home/core/infra-template /home/ebrahim/infra-template \
	&& chmod +x /home/ebrahim/scripts/* \
	&& su - ebrahim -c 'PNPM_HOME=/home/ebrahim/.local/share/pnpm PATH=/home/ebrahim/.local/share/pnpm/bin:/usr/local/bin:/usr/bin:/bin pnpm add --global @openai/codex http-server'

STOPSIGNAL SIGTERM

ENTRYPOINT ["/sbin/openrc-init"]
