[Unit]
Description=Cypht MariaDB

[Container]
ContainerName=cypht-mariadb
Image=docker.io/library/mariadb:11.8
Pull=newer
PublishPort=127.0.0.1:53306:3306
Environment=MARIADB_DATABASE=cypht
Environment=MARIADB_USER=cypht
Environment=MARIADB_PASSWORD=cypth_password
Environment=MARIADB_ROOT_PASSWORD=root_password
Volume=/home/core/infra-template/vps1/volumes/cypht-mariadb:/var/lib/mysql:Z
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=5s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=30s
Notify=healthy

[Service]
TimeoutStartSec=15min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/vps1/volumes/cypht-mariadb

[Install]
WantedBy=default.target
