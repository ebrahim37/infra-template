[Unit]
Description=Cypht webmail
Requires=cypht-mariadb.container
After=cypht-mariadb.container

[Container]
ContainerName=cypht
Image=docker.io/cypht/cypht:2.12.1
Pull=newer
Network=pasta:--map-host-loopback,169.254.1.3
PublishPort={{ vps1.tailnet_ipv4 }}:63146:80
Environment=AUTH_TYPE=DB
Environment=AUTH_USERNAME=admin
Environment=AUTH_PASSWORD=admin
Environment=ADMIN_USERS=admin
Environment=DB_CONNECTION_TYPE=host
Environment=DB_DRIVER=mysql
Environment=DB_HOST=169.254.1.3
Environment=DB_PORT=53306
Environment=DB_NAME=cypht
Environment=DB_USER=cypht
Environment=DB_PASS=cypth_password
Environment=SESSION_TYPE=DB
Environment=USER_CONFIG_TYPE=DB
Environment=ENABLE_REDIS=false
Environment=ENABLE_MEMCACHED=false
Environment=COOKIE_PATH=/
Environment=DEFAULT_SETTING_TIMEZONE=America/Toronto
Volume=/home/core/infra-template/vps1/volumes/cypht-data:/var/lib/hm3:Z

[Service]
TimeoutStartSec=15min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/vps1/volumes/cypht-data
ExecStartPre=/usr/bin/bash -c "until (echo >/dev/tcp/127.0.0.1/53306) 2>/dev/null; do sleep 1; done"
# tailscale-client is a rootful system unit, wait for its interface instead
ExecStartPre=/bin/sh -c "until /usr/sbin/ip -4 addr show dev tailscale0 2>/dev/null | /usr/bin/grep -q '{{ vps1.tailnet_ipv4 | replace(".", "\\.") }}/'; do /usr/bin/sleep 1; done"

[Install]
WantedBy=default.target
