[Unit]
Description=SnappyMail webmail

[Container]
ContainerName=snappymail
Image=docker.io/djmaze/snappymail
Pull=newer
PublishPort={{ vps1.tailnet_ipv4 }}:63146:8888
Environment=TZ=America/Toronto
Environment=SECURE_COOKIES=false
Volume=./container-init.sh:/container-init.sh:ro,Z
Volume=./domains:/managed-domains:ro,Z
Volume=/home/core/infra-template/vps1/volumes/snappymail-data:/var/lib/snappymail:Z
Exec=/bin/sh /container-init.sh

[Service]
TimeoutStartSec=15min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/vps1/volumes/snappymail-data
# tailscale-client is a rootful system unit, wait for its interface instead
ExecStartPre=/bin/sh -c "until /usr/sbin/ip -4 addr show dev tailscale0 2>/dev/null | /usr/bin/grep -Fq '{{ vps1.tailnet_ipv4 }}/'; do /usr/bin/sleep 1; done"

[Install]
WantedBy=default.target
