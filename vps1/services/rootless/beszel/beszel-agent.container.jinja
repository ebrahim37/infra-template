[Unit]
Description=Beszel agent for vps1
Requires=podman.socket
After=network-online.target podman.socket

[Container]
ContainerName=beszel-agent
Image=docker.io/henrygd/beszel-agent
Pull=newer
Network=host
SecurityLabelDisable=true
Environment="LISTEN={{ vps1.tailnet_ipv4 }}:45876"
Environment="KEY={{ vps1.beszel_ssh_public_key }}"
Environment=DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
Volume=/home/core/infra-template/vps1/volumes/beszel-agent-data:/var/lib/beszel-agent:Z
Volume=/run/user/1000/podman/podman.sock:/run/user/1000/podman/podman.sock:ro
Volume=/run/dbus/system_bus_socket:/var/run/dbus/system_bus_socket:ro

[Service]
TimeoutStartSec=15min
ExecStartPre=/bin/sh -c "until /usr/sbin/ip -4 addr show dev tailscale0 2>/dev/null | /usr/bin/grep -Fq '{{ vps1.tailnet_ipv4 }}/'; do /usr/bin/sleep 1; done"
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/vps1/volumes/beszel-agent-data

[Install]
WantedBy=default.target
