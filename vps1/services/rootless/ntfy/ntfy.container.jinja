[Unit]
Description=ntfy notification server

[Container]
ContainerName=ntfy
Image=docker.io/binwiederhier/ntfy
Pull=newer
PublishPort={{ vps1.tailnet_ipv4 }}:2586:80
Environment=TZ=America/Toronto
Volume=./server.yml:/etc/ntfy/server.yml:ro,Z
Volume=/home/core/infra-template/vps1/volumes/ntfy-cache:/var/cache/ntfy:Z
Exec=serve

[Service]
TimeoutStartSec=15min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/vps1/volumes/ntfy-cache
# tailscale-client is a rootful system unit, wait for its interface instead
ExecStartPre=/bin/sh -c "until /usr/sbin/ip -4 addr show dev tailscale0 2>/dev/null | /usr/bin/grep -Fq '{{ vps1.tailnet_ipv4 }}/'; do /usr/bin/sleep 1; done"

[Install]
WantedBy=default.target
