[Unit]
Description=Monitor deployed Quadlet services
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=quadlet-monitor
Image=monitor.build
Pull=never
UserNS=keep-id
User=1000:1000
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
SecurityLabelDisable=true
Environment=MONITOR_HOST=%H
Environment=NTFY_URL=http://100.64.0.1:2586
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=SYSTEMD_PAGER=cat
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket:ro
Volume=/run/user/1000/bus:/run/user/1000/bus:ro
Volume=/run/systemd/system:/run/systemd/system:ro
Volume=/etc/containers/systemd/%H-root:/quadlets/rootful:ro
Volume=/home/core/.config/containers/systemd/%H-rootless:/quadlets/rootless:ro
Volume=/home/core/infra-template/%H/volumes/monitor-state:/var/lib/quadlet-monitor

[Service]
TimeoutStartSec=15min
Restart=always
RestartSec=5s
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/%H/volumes/monitor-state

[Install]
WantedBy=default.target
