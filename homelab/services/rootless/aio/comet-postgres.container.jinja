[Unit]
Description=Comet PostgreSQL

[Container]
ContainerName=comet-postgres
Image=docker.io/postgres:18-alpine
Pull=newer
PublishPort=15432:5432/tcp
Volume=/home/core/infra-template/homelab/volumes/comet-postgres-data:/var/lib/postgresql/data:Z
Environment=POSTGRES_USER=comet
Environment="POSTGRES_PASSWORD={{ homelab.priv_comet_postgres_password }}"
Environment=POSTGRES_DB=comet
Environment=PGDATA=/var/lib/postgresql/data/pgdata
Exec=postgres -c shared_buffers=128MB -c effective_cache_size=384MB -c maintenance_work_mem=64MB -c max_connections=100

[Service]
TimeoutStartSec=15min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/homelab/volumes/comet-postgres-data

[Install]
WantedBy=default.target
