[Unit]
Description=Remux Jellyfin query compatibility proxy
Requires=remux.container
After=remux.container

[Container]
ContainerName=remux-query-proxy
Image=remux-query-proxy.build
PublishPort=8097:8097/tcp
Environment=LISTEN_ADDR=:8097
Environment=UPSTREAM_URL=http://host.containers.internal:18098
User=65532:65532

[Service]
TimeoutStartSec=15min
Restart=on-failure

[Install]
WantedBy=default.target
