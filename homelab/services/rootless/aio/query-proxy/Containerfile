FROM docker.io/library/golang:1.25-alpine AS build

WORKDIR /src
COPY query-proxy/go.mod query-proxy/*.go ./
RUN go test ./... \
	&& CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/remux-query-proxy .

FROM scratch
COPY --from=build /out/remux-query-proxy /remux-query-proxy
USER 65532:65532
ENTRYPOINT ["/remux-query-proxy"]
