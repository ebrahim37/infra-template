[Unit]
Description=Bidirectional Gmail and iCloud mailbox sync
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mbsync
Image=email-tools.build
Pull=never
UserNS=keep-id
User=1000:1000
Exec=/usr/local/bin/mbsync-entrypoint
Environment="GMAIL_MAIN_APP_PASSWORD={{ homelab.priv_email_gmail_main_password }}"
Environment="GMAIL_QA_APP_PASSWORD={{ homelab.priv_email_gmail_qa_password }}"
Environment="ICLOUD_APP_PASSWORD={{ homelab.priv_email_icloud_password }}"
Volume=./mbsyncrc:/etc/mbsyncrc:ro,Z
Volume=/home/core/infra-template/homelab/volumes/email-maildir:/mail:U,z

[Service]
TimeoutStartSec=30min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/homelab/volumes/email-maildir

[Install]
WantedBy=default.target
