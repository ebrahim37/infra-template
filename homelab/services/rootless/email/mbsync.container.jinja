[Unit]
Description=Bidirectional Gmail and iCloud inbox sync
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mbsync
Image=email-tools.build
Pull=never
User=1000:1000
Exec=/usr/bin/mbsync --all
Environment="GMAIL_MAIN_APP_PASSWORD={{ homelab.priv_email_gmail_main_password }}"
Environment="GMAIL_QA_APP_PASSWORD={{ homelab.priv_email_gmail_qa_password }}"
Environment="ICLOUD_APP_PASSWORD={{ homelab.priv_email_icloud_password }}"
Volume=./mbsyncrc:/home/mail/.mbsyncrc:ro,Z
Volume=/home/core/infra-template/homelab/volumes/email-maildir:/mail:U,Z

[Service]
Type=oneshot
TimeoutStartSec=30min
ExecStartPre=/usr/bin/mkdir -p "/home/core/infra-template/homelab/volumes/email-maildir/gmail main/cur" "/home/core/infra-template/homelab/volumes/email-maildir/gmail main/new" "/home/core/infra-template/homelab/volumes/email-maildir/gmail main/tmp" "/home/core/infra-template/homelab/volumes/email-maildir/gmail qa/cur" "/home/core/infra-template/homelab/volumes/email-maildir/gmail qa/new" "/home/core/infra-template/homelab/volumes/email-maildir/gmail qa/tmp" /home/core/infra-template/homelab/volumes/email-maildir/icloud/cur /home/core/infra-template/homelab/volumes/email-maildir/icloud/new /home/core/infra-template/homelab/volumes/email-maildir/icloud/tmp
