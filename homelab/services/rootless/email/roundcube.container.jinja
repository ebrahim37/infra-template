[Unit]
Description=Roundcube webmail
Requires=dovecot.container postfix.container
After=dovecot.container postfix.container

[Container]
ContainerName=roundcube
Image=docker.io/roundcube/roundcubemail:1.7.3-apache
Pull=newer
PublishPort=63146:80
Environment=TZ=America/Toronto
Environment=ROUNDCUBEMAIL_DB_TYPE=sqlite
Environment=ROUNDCUBEMAIL_DEFAULT_HOST=host.containers.internal
Environment=ROUNDCUBEMAIL_DEFAULT_PORT=31143
Environment=ROUNDCUBEMAIL_SMTP_SERVER=host.containers.internal
Environment=ROUNDCUBEMAIL_SMTP_PORT=10025
Environment=ROUNDCUBEMAIL_PLUGINS=archive,zipdownload
Volume=./roundcube-config.php:/var/roundcube/config/email.php:ro,Z
Volume=/home/core/infra-template/homelab/volumes/roundcube-db:/var/roundcube/db:U,Z

[Service]
TimeoutStartSec=15min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/homelab/volumes/roundcube-db

[Install]
WantedBy=default.target
