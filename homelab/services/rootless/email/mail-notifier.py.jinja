#!/usr/bin/env python3
import imaplib
import time
import urllib.error
import urllib.request
from email import policy
from email.header import Header
from email.parser import BytesHeaderParser
from email.utils import getaddresses, parseaddr
from pathlib import Path
from urllib.parse import urlencode

MAIL_ROOT = Path("/mail")
NTFY_URL = "http://100.64.0.1:2586/email"
ROUNDCUBE_URL = "http://homelab.ebra.devices:63146/"
DOVECOT_HOST = "host.containers.internal"
DOVECOT_PORT = 31143
DOVECOT_USER = "mail-notifier"
DOVECOT_PASSWORD = "1234"
POLL_SECONDS = 5.0
HTTP_TIMEOUT_SECONDS = 15.0

def log(message):
    print(time.strftime("%Y-%m-%dT%H:%M:%S%z"), message, flush=True)

def clean_header(value, fallback):
    if value is None:
        return fallback
    cleaned = " ".join(str(value).split())
    return cleaned[:500] or fallback

def sender_name(value):
    name, address = parseaddr(str(value or ""))
    if name:
        return clean_header(name, "Unknown sender")[:200]
    if address:
        return clean_header(address.partition("@")[0], "Unknown sender")[:200]
    return "Unknown sender"

def recipient_label(headers):
    recipients = getaddresses(str(value) for value in headers.get_all("To", []))
    addresses = {address.casefold() for _, address in recipients}
    if "{{ homelab.priv_queens_email }}" in addresses:
        return "queens"
    if "{{ homelab.priv_icloud_email }}" in addresses:
        return "icloud"
    if "{{ homelab.priv_qa_email }}" in addresses:
        return "qa"
    return None

def message_details(path):
    with path.open("rb") as mail:
        headers = BytesHeaderParser(policy=policy.default).parse(mail, headersonly=True)
    return (
        f"{path.parents[2].name}/INBOX",
        recipient_label(headers),
        sender_name(headers.get("From")),
        clean_header(headers.get("Subject"), "(no subject)"),
        clean_header(headers.get("Message-ID"), ""),
    )

def imap_quote(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'

def maildir_basename(name):
    return name.split(":2,", 1)[0]

def message_key(path):
    return str(path.parent.parent / maildir_basename(path.name))

def is_unread(path):
    if path.parent.name == "new":
        return True
    _, separator, flags = path.name.rpartition(":2,")
    return not separator or "S" not in flags

def uid_from_uidlist(path):
    wanted_name = maildir_basename(path.name)
    uidlist = path.parent.parent / "dovecot-uidlist"
    with uidlist.open(encoding="utf-8") as uid_file:
        for line in uid_file:
            metadata, separator, filename = line.rstrip("\n").partition(" :")
            if not separator or maildir_basename(filename) != wanted_name:
                continue
            uid = metadata.split(" ", 1)[0]
            if uid.isdigit():
                return uid
    return None

def dovecot_uid(path, mailbox, message_id):
    client = imaplib.IMAP4(DOVECOT_HOST, DOVECOT_PORT, timeout=HTTP_TIMEOUT_SECONDS)
    try:
        client.login(DOVECOT_USER, DOVECOT_PASSWORD)
        status, _ = client.select(imap_quote(mailbox), readonly=True)
        if status != "OK":
            raise RuntimeError(f"Dovecot could not select {mailbox}")

        if message_id:
            status, data = client.uid(
                "SEARCH", None, "HEADER", "Message-ID", imap_quote(message_id)
            )
            if status == "OK" and data and data[0]:
                uids = [uid for uid in data[0].split() if uid.isdigit()]
                if uids:
                    return str(max(int(uid) for uid in uids))
    finally:
        try:
            client.logout()
        except imaplib.IMAP4.error:
            pass

    uid = uid_from_uidlist(path)
    if uid is None:
        raise RuntimeError(f"Dovecot UID is not available yet for {path}")
    return uid

def roundcube_link(mailbox, uid):
    query = urlencode((('_task', 'mail'), ('_uid', uid), ('_mbox', mailbox)))
    return f"{ROUNDCUBE_URL}?{query}"

def publish(label, sender, subject, link):
    title = f"{sender} ({label})" if label else sender
    try:
        title.encode("ascii")
    except UnicodeEncodeError:
        title = Header(title, "utf-8", maxlinelen=998).encode(linesep="")

    request = urllib.request.Request(
        NTFY_URL,
        data=subject.encode("utf-8"),
        headers={
            "Content-Type": "text/plain; charset=utf-8",
            "Title": title,
            "Click": link,
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_SECONDS) as response:
        if not 200 <= response.status < 300:
            raise RuntimeError(f"ntfy returned HTTP {response.status}")

def seen_name(name):
    if ":2," not in name:
        return f"{name}:2,S"
    base, flags = name.rsplit(":2,", 1)
    return f"{base}:2,{''.join(sorted(set(flags + 'S')))}"

def current_message_path(path):
    if path.exists():
        return path

    wanted_name = maildir_basename(path.name)
    inbox = path.parent.parent
    for directory_name in ("new", "cur"):
        directory = inbox / directory_name
        try:
            for candidate in directory.iterdir():
                if candidate.is_file() and maildir_basename(candidate.name) == wanted_name:
                    return candidate
        except FileNotFoundError:
            continue
    raise FileNotFoundError(path)

def mark_seen(path):
    path = current_message_path(path)
    destination = path.parent.parent / "cur" / seen_name(path.name)
    path.replace(destination)

def new_messages():
    messages = []
    for inbox in MAIL_ROOT.glob("*/INBOX"):
        for directory_name in ("new", "cur"):
            directory = inbox / directory_name
            try:
                messages.extend(
                    path for path in directory.iterdir()
                    if path.is_file() and is_unread(path)
                )
            except FileNotFoundError:
                continue
    return sorted(messages, key=lambda path: (path.stat().st_mtime_ns, str(path)))

notified = set()
while True:
    try:
        messages = new_messages()
    except OSError as error:
        log(f"cannot scan Maildir: {error}")
        time.sleep(POLL_SECONDS)
        continue

    current_paths = {message_key(path) for path in messages}
    notified.intersection_update(current_paths)

    for path in messages:
        path_key = message_key(path)
        try:
            if path_key not in notified:
                mailbox, label, sender, subject, message_id = message_details(path)
                uid = dovecot_uid(path, mailbox, message_id)
                publish(label, sender, subject, roundcube_link(mailbox, uid))
                notified.add(path_key)
                log(f"notified: {subject}")

            mark_seen(path)
            notified.discard(path_key)
            log(f"marked read: {path}")
        except FileNotFoundError:
            notified.discard(path_key)
        except (
            OSError,
            ValueError,
            RuntimeError,
            imaplib.IMAP4.error,
            urllib.error.URLError,
        ) as error:
            log(f"will retry {path}: {error}")

    time.sleep(POLL_SECONDS)
