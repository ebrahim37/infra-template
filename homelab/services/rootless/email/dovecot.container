[Unit]
Description=Local IMAP server for synchronized email

[Container]
ContainerName=dovecot
Image=docker.io/dovecot/dovecot
Pull=newer
UserNS=keep-id
Environment=USER_PASSWORD=1234
PublishPort=31143:31143
Volume=./dovecot.conf:/etc/dovecot/conf.d/99-email.conf:ro,Z
Volume=/home/core/infra-template/homelab/volumes/email-maildir:/srv/vmail:U,z

[Service]
TimeoutStartSec=15min
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/homelab/volumes/email-maildir

[Install]
WantedBy=default.target
