[Unit]
Description=Notify ntfy about new synchronized email
Requires=dovecot.container mbsync.container
After=dovecot.container mbsync.container

[Container]
ContainerName=mail-notifier
Image=email-tools.build
Pull=never
UserNS=keep-id
User=1000:1000
Exec=/usr/local/bin/mail-notifier
Volume=/home/core/infra-template/homelab/volumes/email-maildir:/mail:U,z

[Service]
TimeoutStartSec=15min
Restart=on-failure
RestartSec=10
ExecStartPre=/usr/bin/mkdir -p /home/core/infra-template/homelab/volumes/email-maildir

[Install]
WantedBy=default.target
