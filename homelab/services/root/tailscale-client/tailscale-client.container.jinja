[Unit]
Description=Tailscale client
Requires=network-online.target
After=network-online.target

[Container]
ContainerName=tailscale-client
Image=docker.io/tailscale/tailscale
Pull=newer
Network=host
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN NET_RAW
Volume=/home/core/infra-template/homelab/volumes/tailscale-client-data:/var/lib/tailscale:Z
Environment="TS_AUTHKEY={{ homelab.priv_tailscale_auth_key }}"
Environment=TS_STATE_DIR=/var/lib/tailscale
Environment=TS_USERSPACE=false
Environment=TS_AUTH_ONCE=true
Environment=TS_HOSTNAME={{ homelab.hostname }}
Environment=TS_DEBUG_FIREWALL_MODE=nftables
Environment="TS_ROUTES=192.168.1.0/24"
Environment="TS_EXTRA_ARGS=--login-server=https://headscale.{{ vps1.base_domain }} --advertise-exit-node"

[Service]
TimeoutStartSec=15min
ExecStartPre=install -d -o core -g core -m 0755 /home/core/infra-template/homelab/volumes/tailscale-client-data

[Install]
WantedBy=multi-user.target
